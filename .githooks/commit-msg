#!/bin/sh
# Check a commit message's shape before it lands. Enable with:
#   git config core.hooksPath .githooks
#
# tstorm has no release yet, so this builds it from the tree when the binary is
# not installed. Once it is on PATH the build is skipped.
if command -v tstorm >/dev/null 2>&1; then
  exec tstorm check commit-message "$1"
fi
cd "$(git rev-parse --show-toplevel)" || exit 2
exec go run ./cmd/tstorm check commit-message "$1"
