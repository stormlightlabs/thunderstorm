---
/**
 * The three install commands, side by side.
 *
 * Which agents this runs on is the one thing a reader needs in the first few
 * seconds, and three commands say it faster than a sentence about portability.
 * Rendered through Starlight's own Code component so the frames, the syntax
 * theme and the copy button match every other block on the site.
 */
import { Code } from "@astrojs/starlight/components";

const harnesses = [
  { title: "Claude Code", code: "/plugin marketplace add stormlightlabs/thunderstorm" },
  {
    title: "Codex",
    code: "codex plugin marketplace add stormlightlabs/thunderstorm\ncodex plugin add thunderstorm@stormlightlabs",
  },
  { title: "Pi", code: "pi install git:github.com/stormlightlabs/thunderstorm" },
];
---

<div class="install-grid">
  {harnesses.map(({ title, code }) => <Code code={code} lang="sh" title={title} />)}
</div>

<style>
  .install-grid {
    display: grid;
    gap: 1rem;
    margin: 2.5rem auto 0;
    max-width: 62rem;
    text-align: left;
  }
  @media (min-width: 60rem) {
    .install-grid {
      grid-template-columns: repeat(3, 1fr);
      align-items: start;
    }
  }
</style>
