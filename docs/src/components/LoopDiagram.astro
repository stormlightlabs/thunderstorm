---
/**
 * The shape of one run, drawn once so the introduction does not have to
 * describe it twice. Colors come from the Starlight theme variables, so the
 * diagram follows light and dark without a second copy, and the viewBox lets
 * it shrink to a phone without a media query.
 */
---

<figure class="loop">
  <svg viewBox="0 0 960 280" role="img" aria-labelledby="loop-title loop-desc">
    <title id="loop-title">The shape of one thunderstorm run</title>
    <desc id="loop-desc">
      A person starts a run. The run claims an issue on the board, creates a git
      worktree, implements one sub-issue, and takes the change through three
      review passes, returning to the edit step until the passes are clear. It
      stops with a pull request open, which a person merges.
    </desc>

    <defs>
      <marker id="loop-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" class="loop-arrowhead" />
      </marker>
    </defs>

    <g class="loop-stage">
      <rect x="40" y="76" width="160" height="68" rx="10" />
      <text x="120" y="104">Claim the issue</text>
      <text x="120" y="126" class="loop-sub">board to In Progress</text>
    </g>
    <g class="loop-stage">
      <rect x="220" y="76" width="160" height="68" rx="10" />
      <text x="300" y="104">Give it a worktree</text>
      <text x="300" y="126" class="loop-sub">one per worker</text>
    </g>
    <g class="loop-stage">
      <rect x="400" y="76" width="160" height="68" rx="10" />
      <text x="480" y="104">Implement</text>
      <text x="480" y="126" class="loop-sub">one sub-issue</text>
    </g>
    <g class="loop-stage">
      <rect x="580" y="76" width="160" height="68" rx="10" />
      <text x="660" y="104">Review</text>
      <text x="660" y="126" class="loop-sub">three passes</text>
    </g>
    <g class="loop-stage loop-stage-end">
      <rect x="760" y="76" width="160" height="68" rx="10" />
      <text x="840" y="104">Pull request</text>
      <text x="840" y="126" class="loop-sub">the run stops</text>
    </g>

    <g class="loop-link">
      <line x1="204" y1="110" x2="214" y2="110" marker-end="url(#loop-arrow)" />
      <line x1="384" y1="110" x2="394" y2="110" marker-end="url(#loop-arrow)" />
      <line x1="564" y1="110" x2="574" y2="110" marker-end="url(#loop-arrow)" />
      <line x1="744" y1="110" x2="754" y2="110" marker-end="url(#loop-arrow)" />
    </g>

    <g class="loop-link loop-back">
      <path d="M 660 148 L 660 196 Q 660 208 648 208 L 492 208 Q 480 208 480 196 L 480 150" marker-end="url(#loop-arrow)" />
      <text x="570" y="232" class="loop-sub">edit, until the passes are clear</text>
    </g>

    <g class="loop-person">
      <text x="120" y="46">a person starts the run</text>
      <line x1="120" y1="56" x2="120" y2="68" marker-end="url(#loop-arrow)" />
    </g>
    <g class="loop-person">
      <text x="840" y="46">a person merges</text>
      <line x1="840" y1="68" x2="840" y2="56" marker-end="url(#loop-arrow)" />
    </g>
  </svg>
</figure>

<style>
  .loop {
    margin: 2.5rem auto 0;
    max-width: 60rem;
  }
  .loop svg {
    width: 100%;
    height: auto;
    font-family: var(--sl-font);
  }
  .loop-stage rect {
    fill: var(--sl-color-gray-6);
    stroke: var(--sl-color-hairline);
    stroke-width: 1;
  }
  .loop-stage-end rect {
    fill: var(--sl-color-accent-low);
    stroke: var(--sl-color-accent);
  }
  .loop-stage text {
    fill: var(--sl-color-white);
    font-size: 15px;
    font-weight: 600;
    text-anchor: middle;
  }
  .loop-sub {
    fill: var(--sl-color-gray-3) !important;
    font-size: 12.5px !important;
    font-weight: 400 !important;
  }
  .loop-link line,
  .loop-link path {
    fill: none;
    stroke: var(--sl-color-gray-4);
    stroke-width: 1.5;
  }
  .loop-arrowhead {
    fill: var(--sl-color-gray-4);
  }
  .loop-back path {
    stroke-dasharray: 5 4;
  }
  .loop-person text {
    fill: var(--sl-color-accent-high);
    font-size: 12.5px;
    text-anchor: middle;
  }
  .loop-person line {
    stroke: var(--sl-color-accent);
  }
</style>
