# thunderstorm: a session does not merge or approve its own work.
#
# The plugin hook applies this policy while Thunderstorm is enabled.
# Copy this file into a Codex rules directory only when the same policy
# should apply outside Thunderstorm.

prefix_rule(
    pattern = ["gh", "pr", "merge"],
    decision = "forbidden",
    justification = "only a human merges or approves a thunderstorm run",
)

prefix_rule(
    pattern = ["gh", "pr", "review"],
    decision = "forbidden",
    justification = "only a human merges or approves a thunderstorm run",
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "forbidden",
    justification = "only a human merges or approves a thunderstorm run",
)

prefix_rule(
    pattern = ["git", "merge"],
    decision = "forbidden",
    justification = "only a human merges or approves a thunderstorm run",
)
